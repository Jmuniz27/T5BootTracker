# URL del backend para Expo Go en dispositivo físico.
# Copiar este archivo a .env y reemplazar con la IP local de la PC.
#
# Cómo encontrar tu IP:
#   Windows: ipconfig  → busca "IPv4 Address" de la interfaz WiFi
#   Mac/Linux: ifconfig | grep "inet " o ip addr
#
# El teléfono y la PC deben estar en la misma red WiFi.
# Para emulador Android no es necesario (usa el fallback 10.0.2.2 automáticamente).
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api
