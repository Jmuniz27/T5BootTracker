# Plantilla del .env de boot-tracker en el VPS.
# Destino: /opt/boot-tracker/.env   ·   Dueño: deploy:deploy   ·   Permisos: 600
#
# ⚠️ Este archivo es SOLO la plantilla — los valores reales NUNCA van en git.
#    Rellenar en el servidor y verificar con:  ls -l /opt/boot-tracker/.env
#
# ⚠️ NO reciclar los valores del despliegue de ESPOL (boottracker.taws.espol.edu.ec).
#    Era un servidor temporal y esas credenciales se consideran quemadas.

# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

# Generar uno nuevo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR

# Las tres son OBLIGATORIAS: config/settings/production.py las lee sin default y
# el backend no arranca si falta alguna. Es deliberado — antes traían el dominio
# de ESPOL como fallback y su ausencia se manifestaba mucho más tarde, como un
# DisallowedHost difícil de rastrear.
# 'backend' es necesario: es el nombre del contenedor dentro de la red de Docker.
#
# Se listan LOS DOS hosts desde el principio —el de prueba (sslip.io) y el definitivo—
# para que cuando GoDaddy asigne el registro A no haya que tocar estas tres líneas:
# alcanza con cambiar FRONTEND_URL y pedir el certificado. Un host de más en
# ALLOWED_HOSTS no es un riesgo: sólo dice qué Host header acepta Django, y ambos
# nombres apuntan a este mismo servidor.
ALLOWED_HOSTS=boottracker.94.130.182.254.sslip.io,boottracker.codingbootcampslatam.com,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://boottracker.94.130.182.254.sslip.io,https://boottracker.codingbootcampslatam.com
CORS_ALLOWED_ORIGINS=https://boottracker.94.130.182.254.sslip.io,https://boottracker.codingbootcampslatam.com

# El único que hay que cambiar cuando llegue el dominio real. Se usa para armar los
# enlaces que van por email (activación de cuenta, reset de password), así que tiene
# que ser un único valor y el que el usuario va a poder abrir.
FRONTEND_URL=https://boottracker.94.130.182.254.sslip.io

# --- Base de datos ---------------------------------------------------------
# Contenedor propio, aislado del Postgres de la app de asistencia.
# Generar la password:  openssl rand -base64 32
DB_NAME=boottracker
DB_USER=boottracker
DB_PASSWORD=CAMBIAR
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Email -----------------------------------------------------------------
# Sin estas credenciales el reset de contraseña y todas las notificaciones fallan
# EN SILENCIO: el envío es asíncrono (Celery) y la vista de reset devuelve 200
# igual, por diseño anti-enumeración. production.py avisa por log al arrancar.
#
# Con Gmail hace falta una CONTRASEÑA DE APLICACIÓN, no la del usuario:
#   https://myaccount.google.com/apppasswords  (requiere 2FA activo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CAMBIAR
EMAIL_HOST_PASSWORD=CAMBIAR

# Dejar VACÍO o igual a EMAIL_HOST_USER. Gmail reescribe el remitente (o manda a
# spam) cuando el From no es la cuenta autenticada; si se omite, base.py lo hace
# caer en EMAIL_HOST_USER automáticamente.
DEFAULT_FROM_EMAIL=

# --- Google ----------------------------------------------------------------
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET ya NO se incluyen: se verificó en el
# código que boot-tracker no tiene login con Google. Esas variables no se leen
# en ningún settings y las librerías de Google nunca se importan. La auth es JWT
# propio (rest_framework_simplejwt).
