FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-spa \
    poppler-utils \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ /tmp/requirements/

RUN pip install --no-cache-dir -r /tmp/requirements/production.txt

# Run as non-root for security
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

COPY . .

# `media/` está en .dockerignore, así que /app/media no existe en la imagen. Al
# montar el volumen `media_data` encima, Docker crea el punto de montaje como
# root:root y gunicorn —que corre como appuser— no puede escribir el comprobante:
# la subida moría con PermissionError y un 500 de HTML.
# Creándolo acá, el volumen hereda el dueño del directorio que ya existe.
RUN mkdir -p /app/media /app/staticfiles

RUN chown -R appuser:appgroup /app
USER appuser
