# Django
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=boottracker
DB_USER=boottracker
DB_PASSWORD=boottracker123
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# JWT Token lifetimes (configurados en backend/config/settings/base.py)
# ACCESS: 30 minutos | REFRESH: 1 día

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@espol.edu.ec

# Calendar
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
GOOGLE_CALENDAR_ID=your-calendar-id
WEBHOOK_DOMAIN=https://your-domain.com

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth / API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

# Linear (issue tracking) — la sincronización (/linear-sync) usa el Linear MCP,
# que ya está autenticado con la cuenta conectada. Normalmente NO se necesita token.
# Define esto sólo si necesitas el fallback REST en .claude/scripts/pr_context.py:
# LINEAR_API_TOKEN=lin_api_xxxxxxxx

# Rate limit de login/password-reset (default 5/min). Subirlo solo en entornos de prueba.
# AUTH_THROTTLE_RATE=100/min

# Bot de WhatsApp (Jelou) — secreto compartido que el bot manda en la cabecera
# X-Bot-Token para usar los endpoints /api/leads/bot/. El MISMO valor tiene que
# quedar en los secretos de Jelou; si se rota uno sin el otro, el bot deja de
# guardar leads. Vacío o ausente, esos endpoints rechazan todo.
# Generar uno nuevo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JELOU_BOT_TOKEN=
# Rate limit de los endpoints del bot (default 120/min, contado por IP).
# BOT_THROTTLE_RATE=120/min
