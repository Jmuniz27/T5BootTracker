{
  "permissions": {
    "allow": [
      "Bash(docker-compose*)",
      "Bash(docker compose*)",
      "Bash(python manage.py*)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(npx expo*)",
      "Bash(npx jest*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git pull*)",
      "Bash(gh issue*)",
      "Bash(gh api*)",
      "Bash(gh pr*)",
      "Bash(gh run*)",
      "Bash(git rev-parse*)",
      "Bash(python .claude/scripts/pr_context.py*)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_issue_statuses",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__save_issue",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "WebFetch(domain:docs.djangoproject.com)",
      "WebFetch(domain:reactjs.org)",
      "WebFetch(domain:expo.dev)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tanstack.com)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(DROP DATABASE*)",
      "Bash(DELETE FROM*)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  },
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.dev"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "if": "Bash(git commit*)",
            "prompt": "Before committing, re-read the Git conventions in CLAUDE.md and verify:\n1. The commit message follows `type(scope): description` format (e.g. `feat(leads): add filter`)\n2. The type is one of: feat, fix, docs, style, refactor, test, chore\n3. The description does NOT mention AI tools (no 'Claude', 'Copilot', 'AI-generated', etc.)\n4. The staged changes logically belong to a single scope\nIf any rule is violated, block the commit and explain what needs to be corrected.\nTool input: $ARGUMENTS",
            "statusMessage": "Verificando convenciones de commit..."
          },
          {
            "type": "prompt",
            "if": "Bash(gh pr create*)",
            "prompt": "Before creating the PR, re-read the PR conventions in CLAUDE.md and verify:\n1. The PR title includes the issue number and a short description\n2. The PR body explains what the change does and how to test it\n3. The branch targets `main` (not develop or any other base)\n4. CI must be green before merging (remind the author if it's not confirmed yet)\nIf any required field is missing, block and list exactly what needs to be added.\nTool input: $ARGUMENTS",
            "statusMessage": "Verificando convenciones del PR..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$REPO_ROOT/.claude/hooks/pre-bash.sh\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$REPO_ROOT/.claude/hooks/post-pr.sh\"",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$REPO_ROOT/.claude/hooks/post-file.sh\"",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$REPO_ROOT/.claude/hooks/post-file.sh\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
