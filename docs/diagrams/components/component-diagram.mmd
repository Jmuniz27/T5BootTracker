    %% Clients → Backend
    Frontend -->|REST + JWT| Auth
    Frontend --> Leads
    Frontend --> Payments
    Frontend --> Programs
    Frontend --> Users
    Frontend --> Meetings
    Frontend --> Analytics
    MobileApp -->|REST + JWT| Auth
    MobileApp --> Leads
    MobileApp --> Meetings

    %% Backend → DB
    Auth --> PG
    Leads --> PG
    Payments --> PG
    Programs --> PG
    Users --> PG
    Meetings --> PG
    Analytics --> PG

    %% Backend → Async
    Auth -->|token blacklist| Redis
    Leads -->|enqueue tasks| Celery
    Payments -->|enqueue OCR| Celery
    Notif --> Celery

    %% Celery → infra
    Celery -->|broker / result| Redis
    Celery -->|send emails| SMTP
    Celery -->|parse receipts| OCR

    %% External integrations
    Meetings -->|sync events| GCal

    %% Planned
    Payments -.->|upload receipts - planned| S3
