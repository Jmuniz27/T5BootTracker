flowchart TB
    classDef planned fill:#F5F5F5,stroke:#AAAAAA,color:#888888,stroke-dasharray:5 5

    subgraph Clients
        subgraph Browser["Web Browser"]
            Frontend["React SPA\nVite · Zustand · TanStack Query"]
        end
        subgraph Mobile["Mobile Device"]
            MobileApp["Expo App\nExpo Router · AuthContext"]
        end
    end

    subgraph Backend["Backend — Django 5.1 + DRF"]
        Auth["Authentication\n— JWT simplejwt —\naccess 2 h / refresh 1 d\nRoles: Admin · Salesperson · Bootcamper\nCoordinator · Finance"]
        Leads["Leads"]
        Payments["Payments"]
        Programs["Programs\nprograms and cohorts"]
        Users["Users"]
        Meetings["Meetings\nfollow-up scheduling"]
        Notif["Notifications\nCelery tasks only"]
        Analytics["Analytics\nsalesperson metrics"]
        Swagger["API Docs\ndrf-spectacular"]
    end

    subgraph Infra["Data & Infrastructure"]
        PG[("PostgreSQL 16")]
        Redis["Redis 7"]
        Celery["Celery Worker"]
        SMTP["SMTP Email\nGmail / any SMTP"]
        OCR["OCR Engine\nTesseract"]
    end

    subgraph Ext["External Services"]
        GCal["Google Calendar API"]
        S3["Object Storage\nS3 / MinIO — planned"]:::planned
